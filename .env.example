# Supabase (or any Postgres) connection string — see README → Database.
# Supabase: Project → Connect → "Transaction pooler" URI, with [YOUR-PASSWORD] replaced.
# Put it in .env.local for local development and in your host's environment variables (e.g. Vercel).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Set to "true" to fill an EMPTY database with sample vehicles, jobs and vendors (demo only).
SEED_SAMPLE_DATA=false
